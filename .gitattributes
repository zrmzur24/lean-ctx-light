# Default: let git decide line endings based on content + local git config.
* text=auto

# Shell scripts MUST be LF (otherwise they fail with cryptic errors on
# Linux/macOS bash: "/usr/bin/env: 'bash\r': No such file or directory").
*.sh text eol=lf

# Other text files — explicit LF to normalize across Windows/Linux/macOS
# contributors. Prevents churn when multiple OSes commit to the same file.
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Binaries — never touch
*.png binary
*.jpg binary
*.ico binary
